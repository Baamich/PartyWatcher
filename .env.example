
# Сервер
PORT=
ADMIN_PORT=
NODE_ENV=production
PUBLIC_URL=

# MongoDB
MONGO_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=

# GitHub (один токен, права repo + gist)
GITHUB_TOKEN=

GITHUB_REPO_URL=
GITHUB_BRANCH=
UPDATE_SECRET_KEY=

# Gist (сохранение URL туннеля)
GIST_ID=
GIST_FILENAME=

# Cloudflare Tunnel (без домена)
CLOUDFLARED_PATH=cloudflared
TUNNEL_LOCAL_URL=

GOOGLE_DRIVE_API_KEY=

PROXY_SERVER=
PROXY_USER=
PROXY_PASS=

FORCE_SECURE_COOKIE=

YT_DLP_PATH=
YT_COOKIES_PATH=
YT_CACHE_DIR=
YT_JS_RUNTIMES=
YT_PROXY=
YT_MAX_HEIGHT=
YT_CLIENTS=

THUMB_DIR =

TURN_URL=
TURN_SECRET=
TURN_TTL_SECONDS=

CSP_MODE= # report (только отчёты), enforce (блокировать), off (выключено).

# smtp.resend.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=<API-ключ из Resend>
MAIL_FROM=PartyWatcher <noreply@partywatcher.de>

INBOUND_EMAIL_SECRET=

# Поддержка: адрес, на который человек отвечает на письма (Reply-To). По умолчанию support@partywatcher.de
SUPPORT_EMAIL=

# Автоперевод новостей: ключ DeepL (с ":fx" — бесплатный тариф). Без ключа — MyMemory (~5 тыс. символов/день)
DEEPL_API_KEY=
# необязательно: почта для MyMemory поднимает лимит до ~50 тыс. символов/день (нужна, только если нет DEEPL_API_KEY)
MYMEMORY_EMAIL=

# Kodik: токен API для поиска фильмов/сериалов на главной. Без него комнату Kodik можно создать только по ссылке на плеер
KODIK_TOKEN=
# необязательно: адрес API (по умолчанию https://kodik-api.com) и домен плеера (по умолчанию kodikplayer.com)
KODIK_API_URL=
KODIK_PLAYER_HOST=
# Категории эфиров (игры и «Общение», как на Twitch): приложение на dev.twitch.tv/console → Client ID и Client Secret.
# Без них стример не может выбрать категорию в студии
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Эфиры: сколько трансляций одновременно перекодировать в 720p/360p (по умолчанию 2). Остальные идут только «источником»
LIVE_MAX_TRANSCODES=

# Impressum (страница /impressum, § 18 Abs. 1 MStV: имя и адрес владельца обязательны и для бесплатного сайта из Германии).
# Вместо домашнего адреса можно взять адрес сервиса «Impressum-Adresse» / c/o (не абонентский ящик)
IMPRINT_NAME=
IMPRINT_STREET=
# индекс и город, например: 70173 Stuttgart
IMPRINT_CITY=
# необязательно: страна (по умолчанию Deutschland), почта (по умолчанию SUPPORT_EMAIL), телефон
IMPRINT_COUNTRY=
IMPRINT_EMAIL=
IMPRINT_PHONE=

# Резервные копии базы (scripts/backup-db.js, cron раз в сутки): шифруются этим ключом и уходят в секретный Gist
# (GITHUB_TOKEN с правом gist) и в BACKUP_DIR. Ключ: openssl rand -hex 32 — сохрани его ещё и в менеджере паролей,
# без него копии не расшифровать
BACKUP_KEY=
# папка копий на сервере (по умолчанию ~/pw-backups) и сколько хранить (дней/копий, по умолчанию 7)
BACKUP_DIR=
BACKUP_KEEP=

# Лимиты писем (бесплатный Resend: 100 в сутки, 3000 в месяц; сутки — по UTC). Письма подтверждения регистрации — не больше
# MAIL_REG_DAILY в сутки, остаток — сброс пароля и поддержка. Не влезло — регистрация в очереди, письмо уйдёт завтра,
# ссылка в нём живёт VERIFY_QUEUED_TTL_H часов. Пусто — значения по умолчанию (100 / 3000 / 75 / 8)
MAIL_DAILY_LIMIT=
MAIL_MONTHLY_LIMIT=
MAIL_REG_DAILY=
VERIFY_QUEUED_TTL_H=

# Chromium для «Просмотра фильма» (Puppeteer). Пусто — ищется сам: /usr/bin/chromium-browser, /usr/bin/chromium,
# /snap/bin/chromium, Chromium от Playwright (~/.cache/ms-playwright)
CHROMIUM_PATH=
