# Сервер
PORT=3000
NODE_ENV=production
PUBLIC_URL=

# MongoDB
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/partywatcher

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Загрузка видео
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10240
UPLOAD_TTL_DAYS=30

# GitHub (один токен, права repo + gist)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO_URL=https://github.com/youruser/PartyWatcher.git
GITHUB_BRANCH=main
UPDATE_SECRET_KEY=another_long_random_string

# Gist (сохранение URL туннеля)
GIST_ID=
GIST_FILENAME=partywatcher-tunnel-url.txt

# Cloudflare Tunnel (без домена)
CLOUDFLARED_PATH=C:/cloudflared/cloudflared.exe
TUNNEL_LOCAL_URL=http://localhost:3000